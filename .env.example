# Frontend environment variables
# Copy to .env and fill in real values

# Base URL of the Express backend API
# ✅ Leave BLANK for both development (Vite proxy) and Vercel production.
#    Vercel routes /api/* to server/index.js automatically via vercel.json.
#    Only set this if your backend is hosted on a DIFFERENT domain.
VITE_API_BASE_URL=
