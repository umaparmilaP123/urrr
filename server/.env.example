# Server environment variables
# Copy to .env and fill in real values before running

# Gemini Vision API key (server-side only — never sent to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Express server port
PORT=5000

# express-session secret — change to a long random string in production
SESSION_SECRET=change_me_to_a_long_random_secret_in_production
